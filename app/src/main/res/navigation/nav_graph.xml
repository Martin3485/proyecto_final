<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.torres.nodocivico.ui.splash.SplashFragment">
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.torres.nodocivico.ui.home.HomeFragment">
        <action
            android:id="@+id/action_home_to_list"
            app:destination="@id/reportListFragment" />
        <action
            android:id="@+id/action_home_to_create"
            app:destination="@id/createReportFragment" />
    </fragment>

    <fragment
        android:id="@+id/reportListFragment"
        android:name="com.torres.nodocivico.ui.reports.ReportListFragment" />

    <fragment
        android:id="@+id/createReportFragment"
        android:name="com.torres.nodocivico.ui.reports.CreateReportFragment" />

</navigation>